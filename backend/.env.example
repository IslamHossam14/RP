# Database
DATABASE_URL=postgresql://user:password@localhost:5432/right_place_db

# JWT
JWT_SECRET=your_jwt_secret_key_change_me_in_production
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_me_in_production
REFRESH_TOKEN_EXPIRY=30d

# Server
PORT=3001
NODE_ENV=development

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Email (optional for future use)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Admin
ADMIN_EMAIL=admin@rightplace.com
ADMIN_PASSWORD=AdminPassword123
